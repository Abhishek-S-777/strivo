rules_version = '2';

// Strivo — owner-only access. Every piece of user data lives under
// users/{uid}, so a single recursive rule secures the whole tree:
// users/{uid} (profile + preferences) and its subcollections
// sessions/, routines/, exercise_history/.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // All subcollections (sessions, routines, exercise_history, …)
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Everything else is denied by default.
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
  }
}
